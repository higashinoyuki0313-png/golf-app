<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.golf.app.golfapp.mapper.AccountMapper">

    <select id="findByEmail"
            resultType="com.golf.app.golfapp.model.Account">
        SELECT *
        FROM accounts
        WHERE email = #{email}
    </select>

    <select id="findById"
            resultType="com.golf.app.golfapp.model.Account">

        SELECT *
        FROM accounts
        WHERE id = #{id}

    </select>

    <insert id="insert">
        INSERT INTO accounts (
        name,
        email,
        password,
        role
        ) VALUES (
        #{name},
        #{email},
        #{password},
        #{role}
        )
    </insert>

    <delete id="deleteById">
        DELETE FROM accounts
        WHERE id = #{id}
    </delete>

    <select id="findAll"
            resultType="com.golf.app.golfapp.model.Account">
        SELECT *
        FROM accounts
        ORDER BY id
    </select>

</mapper>